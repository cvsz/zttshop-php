# TikTok Shop API base URL
SERVER_URL=

# TikTok Shop auth base URL
AUTH_URL=

# Exact TikTok Shop authorization URL used to start the login flow, for example:
# https://shop.tiktok.com/alliance/creator/auth
AUTH_AUTHORIZE_URL=

# App credentials from the TikTok Shop developer portal
APP_KEY=
APP_SECRET=

# OAuth / shop access values returned by the authorization flow
ACCESS_TOKEN=
REFRESH_TOKEN=
AUTH_CODE=
SHOP_ID=

# Optional label used by the integration test assertion
SELLER_NAME=
