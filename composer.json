{
    "name": "haistar/tiktokshop-api-client",
    "description": "Unofficial TikTok Shop API client built in PHP",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/cvsz/zttshop-php",
    "autoload": {
        "psr-4": {
            "Aftwork\\TiktokShop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "raviMukti",
            "email": "shinjiravi@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "vlucas/phpdotenv": "^5.3"
    },
    "require": {
        "guzzlehttp/guzzle": "^7.0"
    },
    "scripts": {
        "test" : "vendor/bin/phpunit --testdox"
    },
    "support": {
        "issues": "https://github.com/cvsz/zttshop-php/issues",
        "source": "https://github.com/cvsz/zttshop-php"
    }
}
